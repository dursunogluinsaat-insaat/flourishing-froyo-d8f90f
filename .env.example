# Never commit real values. Set these in Vercel Project Settings.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=emlak_crm
CRM_SESSION_SECRET=replace-with-a-long-random-secret
# Used only when the first device has no local admin to migrate.
CRM_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_FIRST_NAME=Yönetici
CRM_ADMIN_LAST_NAME=Admin
# Optional: protect one-time localStorage member migration.
# CRM_MIGRATION_TOKEN=replace-with-a-one-time-token
